<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 Riego IoT"
            android:textColor="@color/texto"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Tarjeta de conexion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tarjeta"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <EditText
                android:id="@+id/inputIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_ip"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/inputUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_usuario"
                android:inputType="text"
                android:layout_marginTop="8dp"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/inputClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_clave"
                android:inputType="textPassword"
                android:layout_marginTop="8dp"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnConectar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_guardar"
                android:backgroundTint="@color/primario"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/error"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tarjeta de estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tarjeta"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_suelo"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/tvSuelo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valor_pendiente"
                android:textColor="@color/texto"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_aire"
                android:textColor="@color/texto_secundario"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvAire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valor_pendiente"
                android:textColor="@color/texto"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModoBomba"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valor_pendiente"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCambiarModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_cambiar_modo"
            android:backgroundTint="@color/primario"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:id="@+id/layoutManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnEncender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_encender"
                android:backgroundTint="@color/primario"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnApagar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_apagar"
                android:backgroundTint="@color/texto_secundario"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
