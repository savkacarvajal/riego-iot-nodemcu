# Copia este archivo como ".env" y completa tus datos.
# .env esta en .gitignore: NO se sube a GitHub.

# IP local del NodeMCU en tu red (la que imprime por Serial al conectarse al WiFi)
NODEMCU_IP=192.168.1.50

# Mismas credenciales que WEB_USER/WEB_PASS en firmware/riego_nodemcu/config.h
NODEMCU_USER=admin
NODEMCU_PASS=cambia-esta-clave

# URL de tu Realtime Database (Firebase Console -> Realtime Database -> arriba de la tabla)
FIREBASE_DB_URL=https://tu-proyecto-default-rtdb.firebaseio.com

# Cada cuánto (ms) el bridge consulta al NodeMCU
POLL_MS=2000

# Cuántos eventos de historial conservar en la base (se recorta lo más viejo)
HISTORIAL_MAX=200

# Cada cuánto (ms) se guarda una muestra de humedad de suelo para el gráfico de tendencia
LECTURA_INTERVALO_MS=60000

# Cuántas muestras de /lecturas conservar (se recorta lo más viejo)
LECTURAS_MAX=200

# Ruta al archivo de cuenta de servicio (Firebase Console -> Configuración del proyecto
# -> Cuentas de servicio -> Generar nueva clave privada). NO se sube a GitHub.
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
